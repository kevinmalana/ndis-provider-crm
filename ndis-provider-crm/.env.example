# Supabase (required at runtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required only for the guarded synthetic development seed.
SUPABASE_SYNTHETIC_SEED=false
SUPABASE_PROJECT_ENV=development

# App (required at runtime)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrapping (required only for `pnpm bootstrap`)
# The script reads these from process.env. Kevin sets FOUNDING_ADMIN_EMAIL
# directly in .env.local; it is never typed into chat. Defaults for the
# org name and slug match the locked decision in decision-log/2026-08-06:
# platform operator is "Open NDIS" (slug "opendis").
FOUNDING_ORG_NAME=Open NDIS
FOUNDING_ORG_SLUG=opendis
FOUNDING_ADMIN_EMAIL=
