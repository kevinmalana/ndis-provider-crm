{
  "name": "ndis-provider-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "a11y:axe": "node scripts/a11y/axe-check.mjs",
    "a11y:pa11y": "node scripts/a11y/pa11y-check.mjs",
    "a11y": "pnpm a11y:axe && pnpm a11y:pa11y",
    "db:parse": "node --import tsx scripts/parse-migrations.mjs",
    "db:test": "vitest run",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/types.gen.ts",
    "bootstrap": "node --env-file=.env.local --import tsx scripts/bootstrap-founding-tenant.ts",
    "seed:synthetic": "node --env-file=.env.local --import tsx scripts/seed-synthetic.ts",
    "validate:synthetic-admin": "node --env-file=.env.local --import tsx scripts/validate-synthetic-admin-journey.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "happy-dom": "^15.11.7",
    "libpg-query": "^17.7.4",
    "pa11y": "9.1.1",
    "playwright": "1.62.1",
    "postcss": "^8.5.25",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.7",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.20.0"
}
